{
  "name": "@crr/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "crr": "./dist/cli.js",
    "crr-codegen": "./dist/codegen-cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/codegen-cli.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@crr/core": "workspace:*",
    "@crr/surface-browser": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsup": "^8.3.0",
    "@crr/fixture-corebank-web": "workspace:*",
    "playwright": "^1.55.0"
  }
}
