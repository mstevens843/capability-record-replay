  },
  "dependencies": {
    "@crr/core": "workspace:*",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsup": "^8.3.0",
    "@crr/fixture-corebank-tui": "workspace:*"
  }
}
