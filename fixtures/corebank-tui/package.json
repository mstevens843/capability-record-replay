{
  "name": "@crr/fixture-corebank-tui",
  "version": "0.0.0",
  "private": true,
  "description": "The 80x24 green-screen teller app: a Symitar-Episys-shaped inquiry screen with two tenant variants and four injectable fault modes, so surface-terminal has something hostile to drive. Synthetic data only.",
  "type": "module",
  "main": "./src/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": { "types": "./dist/app.d.ts", "import": "./src/app.js" },
    "./app": { "types": "./dist/app.d.ts", "import": "./src/app.js" },
    "./render": { "types": "./dist/render.d.ts", "import": "./src/render.js" },
    "./faults": { "types": "./dist/faults.d.ts", "import": "./src/faults.js" },
    "./tenants": { "types": "./dist/tenants.d.ts", "import": "./src/tenants.js" },
    "./data": { "types": "./dist/data.d.ts", "import": "./src/data.js" }
  },
  "files": ["src", "dist"],
  "scripts": {
    "start": "node src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": { "typescript": "^5.6.3", "vitest": "^2.1.4" }
}
