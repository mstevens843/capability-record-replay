# Discovery runs need a model. Replay does NOT - the whole point of the artifact is that the
# production path has no model in it. `pnpm demo:replay` works with no key at all.

# Anthropic is the primary provider.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Setting this runs the same discovery loop through the OpenAI adapter, which is how
# we show the discovery loop is not coupled to one provider.
OPENAI_API_KEY=

# Model override. Defaults to claude-opus-5.
CRR_MODEL=claude-opus-5
